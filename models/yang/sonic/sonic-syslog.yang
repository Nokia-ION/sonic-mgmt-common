module sonic-syslog {

    yang-version 1.1;

    namespace "http://github.com/sonic-net/sonic-system-syslog";
    prefix syslog;

    import ietf-inet-types {
        prefix inet;
    }

    description "Syslog YANG Module for SONiC OS: remote syslog logging";

    revision 2026-08-21 {
        description "Add protocol tls and align tls_profile_id with Certz host copies.";
    }

    revision 2022-04-18 {
        description "Initial revision.";
    }

    typedef rsyslog-protocol {
        description "The protocol to send logs to a remote server";
        type enumeration {
            enum tcp;
            enum udp;
            enum tls;
        }
    }

    container sonic-syslog {

        container SYSLOG_SERVER {

            description "Syslog Server configuration table.";

            list SYSLOG_SERVER_LIST {

                key "server_address";
                description "List of configured Syslog servers";

                leaf server_address {
                    description "Syslog server IP address";
                    type inet:host;
                }

                leaf port {
                    description "Syslog server UDP or TLS port";
                    type inet:port-number;
                }

                leaf protocol {
                    description "The protocol to send logs to remote server";
                    type rsyslog-protocol;
                }

                leaf transport_security {
                    description "Syslog transport layer security (TLS)";
                    type boolean;
                }

                leaf tls_profile_id {
                    description
                        "gNSI Certz SSL profile id. Host PEMs live under
                         /etc/sonic/rsyslog-certs/<id>/. Required when TLS is enabled.";
                    type string {
                        pattern '[A-Za-z0-9._-]+';
                    }
                }

                leaf applied_transport_security {
                    description "STATE_DB: whether TLS omfwd was actually applied for this server";
                    type boolean;
                }

                leaf failure_reason {
                    description "STATE_DB: why TLS was not applied, if applicable";
                    type enumeration {
                      enum NONE;
                      enum NO_PROFILE;
                      enum NO_CERTIFICATE;
                      enum INVALID_CERTIFICATE;
                      enum RSYSLOG_APPLY_FAILED;
                    }
                }
            }
            /* end of list SYSLOG_SERVER_LIST */
        }
        /* end of container SYSLOG_SERVER */

        container SYSLOG_CONFIG {

            description "Global syslog daemon configuration.";

            container GLOBAL {
                description "Global syslog settings.";

                leaf src_intf {
                    type string;
                    description
                        "Global source interface (e.g. Loopback0) whose IP address is
                         used as the source address for remote syslog forwarding.
                         Equivalent to EOS 'logging source-interface'.";
                }
            }
        }
        /* end of container SYSLOG_CONFIG */
    }
    /* end of container sonic-syslog */
}
