      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:next-hop-groups/oc-netinst:next-hop-group/oc-netinst:next-hops/oc-netinst:next-hop/oc-netinst:state {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_next_hop_groups_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:next-hop-groups/oc-netinst:next-hop-group/oc-netinst:next-hops/oc-netinst:next-hop/oc-netinst:state/oc-netinst:index {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_next_hop_groups_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:next-hop-groups/oc-netinst:next-hop-group/oc-netinst:next-hops/oc-netinst:next-hop/oc-netinst:state/oc-netinst:weight {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_next_hop_groups_xfmr";
      }
    }

    // The AFT IPv4 unicast entry list maps ROUTE_TABLE, whose Redis key is the
    // prefix. Only a route FRR resolved through a next-hop group carries a
    // group id, so state/next-hop-group is absent on a route that references
    // its single next-hop inline.
    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast {
      deviate add {
          sonic-ext:virtual-table "true";
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    // The path transformer turns the ROUTE_TABLE key a keyspace notification
    // carries back into the path of the entry it changed, which is what lets
    // this list be subscribed on change. It is inherited by the nodes below.
    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast/oc-netinst:ipv4-entry {
      deviate add {
          sonic-ext:virtual-table "true";
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
          sonic-ext:path-transformer "ni_afts_entries_path_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast/oc-netinst:ipv4-entry/oc-netinst:prefix {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast/oc-netinst:ipv4-entry/oc-netinst:state {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast/oc-netinst:ipv4-entry/oc-netinst:state/oc-netinst:prefix {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv4-unicast/oc-netinst:ipv4-entry/oc-netinst:state/oc-netinst:next-hop-group {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    // ROUTE_TABLE holds both address families in one table, so the IPv6 entry
    // list is served by the same transformer as the IPv4 one and differs only
    // in the family it filters the rows on.
    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast {
      deviate add {
          sonic-ext:virtual-table "true";
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast/oc-netinst:ipv6-entry {
      deviate add {
          sonic-ext:virtual-table "true";
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
          sonic-ext:path-transformer "ni_afts_entries_path_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast/oc-netinst:ipv6-entry/oc-netinst:prefix {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast/oc-netinst:ipv6-entry/oc-netinst:state {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast/oc-netinst:ipv6-entry/oc-netinst:state/oc-netinst:prefix {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:afts/oc-netinst:ipv6-unicast/oc-netinst:ipv6-entry/oc-netinst:state/oc-netinst:next-hop-group {
      deviate add {
          sonic-ext:db-name "APPL_DB";
          sonic-ext:subtree-transformer "ni_afts_entries_xfmr";
      }
    }

}
