    deviation /oc-netinst:network-instances/oc-netinst:network-instance/oc-netinst:protocols/oc-netinst:protocol/oc-netinst:static-routes/oc-netinst:static/oc-netinst:next-hops {
      deviate add {
          sonic-ext:virtual-table "true";
          sonic-ext:db-name "CONFIG_DB";
          sonic-ext:subtree-transformer "ni_static_route_cfg_xfmr";
