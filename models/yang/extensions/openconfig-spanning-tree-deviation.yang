module openconfig-spanning-tree-deviation {

    yang-version "1.1";

    namespace "http://openconfig.net/yang/spanning-tree/deviation/extension";
    prefix "oc-stp-dev";

    import openconfig-extensions { prefix oc-ext; }
    import openconfig-spanning-tree { prefix oc-stp; }

    organization "Nokia";
    contact "Nokia";
    description
        "Deviation module for OpenConfig spanning-tree on SONiC.
         RSTP is supported via MSTP instance 0 (CIST).";

    oc-ext:openconfig-version "0.1.0";

    revision 2026-09-02 {
        description
            "Extend OC stp-link-type with AUTO to match SONiC STP_PORT.link_type.";
        reference "0.2.3";
    }

    revision 2026-09-02 {
        description
            "Allow RSTP state bridge-priority 0 so GET matches IEEE/SONiC range.";
        reference "0.2.2";
    }

    revision 2026-08-22 {
        description
            "Allow RSTP interface port-priority 0 to match SONiC/IEEE range.";
        reference "0.2.1";
    }

    revision 2026-08-06 {
        description
            "Allow bridge-priority 0 on RSTP config to match SONiC/IEEE range.";
        reference "0.2.0";
    }

    revision 2026-07-22 {
        description
            "Initial revision: RSTP-only support mapped to MSTI 0.";
        reference "0.1.0";
    }

    typedef stp-link-type-ext {
        type enumeration {
            enum P2P {
                description
                    "Point-to-Point link";
            }
            enum SHARED {
                description
                    "Shared link";
            }
            enum AUTO {
                description
                    "Automatically determine the interface link type (SONiC STP_PORT.link_type auto)";
            }
        }
        description
            "SONiC extension of OpenConfig stp-link-type; AUTO is not in standard OC.";
    }

    deviation /oc-stp:stp/oc-stp:mstp {
        deviate not-supported;
    }

    deviation /oc-stp:stp/oc-stp:rapid-pvst {
        deviate not-supported;
    }

    deviation /oc-stp:stp/oc-stp:rstp/oc-stp:config/oc-stp:bridge-priority {
        deviate replace {
            type uint32 {
                range "0..61440";
            }
        }
    }

    deviation /oc-stp:stp/oc-stp:rstp/oc-stp:state/oc-stp:bridge-priority {
        deviate replace {
            type uint32 {
                range "0..61440";
            }
        }
    }

    deviation /oc-stp:stp/oc-stp:rstp/oc-stp:interfaces/oc-stp:interface/oc-stp:config/oc-stp:port-priority {
        deviate replace {
            type uint8 {
                range "0..240";
            }
        }
    }

    deviation /oc-stp:stp/oc-stp:rstp/oc-stp:interfaces/oc-stp:interface/oc-stp:state/oc-stp:port-priority {
        deviate replace {
            type uint8 {
                range "0..240";
            }
        }
    }

    deviation /oc-stp:stp/oc-stp:interfaces/oc-stp:interface/oc-stp:config/oc-stp:link-type {
        deviate replace {
            type stp-link-type-ext;
        }
    }

    deviation /oc-stp:stp/oc-stp:interfaces/oc-stp:interface/oc-stp:state/oc-stp:link-type {
        deviate replace {
            type stp-link-type-ext;
        }
    }
}
